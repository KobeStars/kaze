<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuration d'artefact SignPath de Kaze (à coller dans app.signpath.io →
  projet Kaze → Artifact Configurations). GitHub Actions envoie l'installateur
  dans une archive ZIP (actions/upload-artifact), d'où la racine <zip-file>.
  Seul l'installateur est signé : Kaze.exe et les DLL viennent d'Electron (castLabs)
  et tor.exe du Tor Project, ce ne sont pas des binaires compilés par ce dépôt.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="Kaze-Setup-*.exe" product-name="Kaze">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
