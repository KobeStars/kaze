{
  "name": "kaze",
  "productName": "Kaze",
  "version": "0.2.16",
  "description": "Kaze 風 — Navigue comme le vent. Un navigateur léger, rapide et élégant.",
  "author": "Kordix Studio",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "npm run i18n && tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "polices": "node scripts/polices-jp.mjs",
    "logo": "electron scripts/logo.mjs",
    "dist": "npm run tor && npm run build && electron-builder --win --publish never",
    "postinstall": "node node_modules/electron/install.js",
    "release": "node scripts/publier.mjs",
    "tor": "node scripts/tor.mjs",
    "i18n": "node scripts/i18n.mjs"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.3",
    "electron-updater": "^6.8.11",
    "fflate": "^0.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/shippori-mincho": "^5.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "github:castlabs/electron-releases#v45.2.1+wvcus",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "emmet-monaco-es": "^5.7.0",
    "monaco-editor": "^0.57.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
